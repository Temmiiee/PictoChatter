{
  "name": "pictochatter",
  "version": "1.0.0",
  "description": "PictoChatter social platform",
  "main": "main.electron.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\""
  },
  "keywords": [
    "pictochat",
    "chat",
    "social"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "socket.io": "^4.6.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^40.4.1",
    "nodemon": "^3.0.3",
    "wait-on": "^9.0.4"
  }
}
